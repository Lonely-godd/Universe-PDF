# Скопируйте в .env. Не публикуйте настоящий токен.
BOT_TOKEN=
# Пустое значение разрешает всем; иначе Telegram user ID через запятую.
ALLOWED_USER_IDS=
MAX_FILES=100
MAX_FILE_BYTES=20000000
MAX_TOTAL_BYTES=100000000
MAX_OUTPUT_BYTES=49000000
MAX_PAGES=500
MAX_SESSIONS=20
TTL_SECONDS=3600
CONVERSION_TIMEOUT=180
OFFICE_TIMEOUT=60
CONVERSION_CONCURRENCY=1
# Необязательно: абсолютный путь к шрифту с кириллицей.
FONT_PATH=
# Windows: C:/Program Files/LibreOffice/program/soffice.exe
OFFICE_BINARY=soffice
